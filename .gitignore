# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit local secrets
.env.local
.env*.local

# GitHub token for Cowork auto-publish — never commit
.gh_token
**/.gh_token

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local reference materials (books, PDFs) — not deployed
/references/

# local research pipeline data — auto-generated, not deployed
/data/

# research working folders — local only, not deployed
/drone-papers/
/basketball-papers/
/articles/
/shown_papers.md
/*.md

# dashboard/article pipelines & drafts — local only, only public/ output is committed
/drafts/
/reviews/
/maritime-reports/
/warfare-papers/
/flight-papers/
/drone-index.csv
/scripts/drone-index/
/scripts/review-dashboard/
/*.bat

# Claude Code：發文流程的設定要跨機器同步（hook、文章小隊、slash command），
# 所以只排除本機專屬的部分，其餘進版控
/.claude/worktrees/
/.claude/settings.local.json
/.claude/*.local.json

# 排程執行記錄（本機/OneDrive 專用，不上線）
/automation/

# 卡片縮圖：build 前由 prebuild 自動產生，不進版控（避免過期縮圖與 repo 膨脹）
/public/images/thumbs/
