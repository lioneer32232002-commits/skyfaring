# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit local secrets
.env.local
.env*.local

# GitHub token for Cowork auto-publish — never commit
.gh_token
**/.gh_token

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local reference materials (books, PDFs) — not deployed
/references/

# local research pipeline data — auto-generated, not deployed
/data/

# research working folders — local only, not deployed
/drone-papers/
/basketball-papers/
/articles/
/shown_papers.md
/*.md

# Claude Code internal tooling
/.claude/
